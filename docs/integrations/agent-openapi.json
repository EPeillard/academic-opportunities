{
  "openapi": "3.1.0",
  "info": {
    "title": "Academic Opportunities synthetic extraction PoC",
    "version": "0.1.0",
    "description": "Private synthetic-only bridge. No publication, raw MIME, real messages or live URL is provided."
  },
  "servers": [
    {
      "url": "https://agent-poc.example.invalid",
      "description": "Replace only after separately authorized isolated HTTPS exposure."
    }
  ],
  "paths": {
    "/api/agent/pending-batch": {
      "get": {
        "operationId": "getPendingSyntheticBatch",
        "summary": "Claim or resume a synthetic extraction batch",
        "description": "Returns at most three curated untrusted synthetic messages. Allocates a private batch with a fifteen-minute expiry.",
        "x-openai-isConsequential": true,
        "security": [{ "OAuth": ["agent:read:synthetic"] }],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Synthetic pending batch or empty result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BatchResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid request or evidence",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "403": {
            "description": "Scope or origin denied",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Unknown or unauthorized batch",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "Idempotency or allocation conflict",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "410": {
            "description": "Expired or suppressed batch",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "429": {
            "description": "Request limit reached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "503": {
            "description": "Disabled, unconfigured or unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/agent/extraction-results": {
      "post": {
        "operationId": "submitSyntheticExtractionResults",
        "summary": "Submit a complete synthetic batch for later validation",
        "description": "Strict, idempotent private submission. Batch, principal, expiry and evidence are checked. No automatic publication.",
        "x-openai-isConsequential": true,
        "security": [{ "OAuth": ["agent:submit:synthetic"] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Submission" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Immutable pending-validation receipt; identical retries return the same receipt",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Receipt" }
              }
            }
          },
          "400": {
            "description": "Invalid request or evidence",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "403": {
            "description": "Scope or origin denied",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Unknown or unauthorized batch",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "Idempotency or allocation conflict",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "410": {
            "description": "Expired or suppressed batch",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "429": {
            "description": "Request limit reached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "503": {
            "description": "Disabled, unconfigured or unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.example.invalid/authorize",
            "tokenUrl": "https://auth.example.invalid/token",
            "scopes": {
              "agent:read:synthetic": "Retrieve synthetic fixtures only",
              "agent:submit:synthetic": "Submit private synthetic candidates only"
            }
          }
        }
      }
    },
    "schemas": {
      "BatchQuery": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "limit": {
            "default": 3,
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "cursor": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["limit"],
        "additionalProperties": false
      },
      "BatchResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schemaVersion": { "type": "number", "const": 1 },
          "batchId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              { "type": "null" }
            ]
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              { "type": "null" }
            ]
          },
          "nextCursor": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "messages": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "messageId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "synthetic": { "type": "boolean", "const": true },
                "contentType": { "type": "string", "const": "text/plain" },
                "textSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "untrustedText": { "type": "string", "maxLength": 6000 }
              },
              "required": [
                "messageId",
                "synthetic",
                "contentType",
                "textSha256",
                "untrustedText"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schemaVersion",
          "batchId",
          "expiresAt",
          "nextCursor",
          "messages"
        ],
        "additionalProperties": false
      },
      "Submission": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schemaVersion": { "type": "number", "const": 1 },
          "batchId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "submissionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "results": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "messageId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "candidates": {
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "fields": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              { "type": "null" }
                            ]
                          },
                          "jobType": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "Internship",
                                  "PhD",
                                  "Postdoc",
                                  "Research Engineer",
                                  "Research Scientist",
                                  "Faculty",
                                  "Other"
                                ]
                              },
                              { "type": "null" }
                            ]
                          },
                          "organization": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              { "type": "null" }
                            ]
                          },
                          "laboratory": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              { "type": "null" }
                            ]
                          },
                          "country": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              { "type": "null" }
                            ]
                          },
                          "city": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              { "type": "null" }
                            ]
                          },
                          "topics": {
                            "maxItems": 12,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "Human–Computer Interaction",
                                "Extended Reality",
                                "Graphics & Visualization",
                                "Robotics & HRI",
                                "AI & Machine Learning",
                                "Computer Vision",
                                "Perception & Cognitive Science",
                                "Software Engineering",
                                "Cybersecurity",
                                "Data Science",
                                "Human Factors",
                                "Interdisciplinary"
                              ]
                            }
                          },
                          "duration": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              { "type": "null" }
                            ]
                          },
                          "compensation": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              { "type": "null" }
                            ]
                          },
                          "startDate": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date",
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                              },
                              { "type": "null" }
                            ]
                          },
                          "applicationDeadline": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date",
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                              },
                              { "type": "null" }
                            ]
                          },
                          "contact": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              { "type": "null" }
                            ]
                          },
                          "applicationUrl": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 2048,
                                "format": "uri"
                              },
                              { "type": "null" }
                            ]
                          },
                          "description": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4000
                              },
                              { "type": "null" }
                            ]
                          }
                        },
                        "required": [
                          "title",
                          "jobType",
                          "organization",
                          "laboratory",
                          "country",
                          "city",
                          "topics",
                          "duration",
                          "compensation",
                          "startDate",
                          "applicationDeadline",
                          "contact",
                          "applicationUrl",
                          "description"
                        ],
                        "additionalProperties": false
                      },
                      "evidence": {
                        "maxItems": 30,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "enum": [
                                "title",
                                "jobType",
                                "organization",
                                "laboratory",
                                "country",
                                "city",
                                "topics",
                                "duration",
                                "compensation",
                                "startDate",
                                "applicationDeadline",
                                "contact",
                                "applicationUrl",
                                "description"
                              ]
                            },
                            "messageId": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000
                            },
                            "start": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "end": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "field",
                            "messageId",
                            "quote",
                            "start",
                            "end"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": ["fields", "evidence"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["messageId", "candidates"],
              "additionalProperties": false
            }
          }
        },
        "required": ["schemaVersion", "batchId", "submissionId", "results"],
        "additionalProperties": false
      },
      "Receipt": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "batchId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "messageCount": { "type": "integer", "minimum": 1, "maximum": 3 },
          "state": { "type": "string", "const": "pending_validation" }
        },
        "required": [
          "submissionId",
          "batchId",
          "receivedAt",
          "messageCount",
          "state"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } },
        "required": ["error"],
        "additionalProperties": false
      }
    }
  }
}
