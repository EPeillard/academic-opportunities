{
  "name": "@academic/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787 --inspector-port 0",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file seeds/synthetic.sql"
  },
  "dependencies": {
    "@academic/shared": "*"
  },
  "license": "MIT"
}
