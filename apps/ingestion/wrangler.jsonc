{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "academic-opportunities-ingestion-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "local",
    "INGESTION_ENABLED": "true",
    "PROCESSING_ENABLED": "true",
    "MAX_MESSAGE_BYTES": "2097152",
    "MAX_DAILY_MESSAGES": "500",
    "RAW_RETENTION_DAYS": "30",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "academic-opportunities-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../worker/migrations",
      "remote": false,
    },
  ],
  "r2_buckets": [
    {
      "binding": "RAW_EMAILS",
      "bucket_name": "academic-opportunities-emails",
      "remote": false,
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "academic-opportunities-ingestion",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "retry_delay": 60,
        "max_concurrency": 1,
      },
    ],
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "academic-opportunities-ingestion",
        "remote": false,
      },
    ],
  },
}
