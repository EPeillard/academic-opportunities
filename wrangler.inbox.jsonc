{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "academic-opportunities-inbox",
  "main": "workers/inbox.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "INBOX_ADDRESS": "offres@inbox.etiennepeillard.com" },
  "r2_buckets": [
    { "binding": "MAIL", "bucket_name": "academic-opportunities-inbox" },
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
