{
  "name": "academic-opportunities",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @academic/web",
    "build": "npm run validate:data && npm run build -w @academic/web",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "preview": "npm run preview -w @academic/web",
    "validate:data": "tsx scripts/validate-data.ts",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "happy-dom": "21.0.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.100.0",
    "tsx": "4.21.0"
  },
  "type": "module",
  "license": "MIT"
}
