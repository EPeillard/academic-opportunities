{
  "name": "academic-opportunities",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:web && concurrently -k -n api,web \"npm run dev -w @academic/worker\" \"npm run dev -w @academic/web\"",
    "build:web": "npm run build -w @academic/web",
    "build": "npm run build:web && npm run build -w @academic/worker && npm run build -w @academic/ingestion && npm run build -w @academic/agent",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/worker && tsc --noEmit -p apps/web && tsc --noEmit -p apps/ingestion && tsc --noEmit -p apps/agent",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "npm run db:migrate -w @academic/worker",
    "db:seed": "npm run db:seed -w @academic/worker",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "preview": "npm run dev -w @academic/worker",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:ingestion": "npm run dev -w @academic/ingestion",
    "configure:production": "node scripts/configure-production.mjs",
    "db:migrate:local": "npm run db:migrate",
    "db:migrate:production": "wrangler d1 migrations apply DB --config apps/worker/wrangler.production.jsonc --remote",
    "configure:demo": "node scripts/demo-environment.mjs configure",
    "demo:dry-run": "node scripts/demo-environment.mjs dry-run",
    "demo:verify-target": "node scripts/demo-environment.mjs verify-target",
    "demo:migrate": "node scripts/demo-environment.mjs migrate",
    "demo:seed": "node scripts/demo-environment.mjs seed",
    "demo:deploy": "node scripts/demo-environment.mjs deploy",
    "test:demo": "node scripts/smoke-demo.mjs",
    "demo:verify-live": "node scripts/verify-live-demo.mjs",
    "test:ingestion": "npm run build -w @academic/ingestion && node scripts/smoke-ingestion.mjs",
    "ingestion:prepare-activation": "node scripts/prepare-ingestion.mjs --prepare-activation",
    "ingestion:verify-target": "node scripts/prepare-ingestion.mjs verify-target",
    "dev:agent": "npm run dev -w @academic/agent",
    "test:agent": "npm run build -w @academic/ingestion && npm run build -w @academic/agent && node scripts/smoke-agent.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "happy-dom": "21.0.3",
    "jsonc-parser": "3.3.1",
    "miniflare": "4.20260611.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.100.0"
  },
  "type": "module",
  "license": "MIT"
}
